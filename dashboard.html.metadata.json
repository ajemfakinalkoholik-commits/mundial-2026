{% extends "base.html" %}

{% block content %}
<div style="text-align: center; margin-bottom: 20px;">
    <h2>Witaj w Typerze!</h2>
    <p style="color: var(--text-secondary);">Wytypuj wyniki nadchodzących spotkań.</p>
</div>

<div style="display: flex; justify-content: center; gap: 15px; margin-bottom: 20px;">
    <a href="{{ url_for('dashboard', sort='group') }}" style="padding: 8px 20px; border-radius: 20px; text-decoration: none; font-weight: bold; background: {% if request.args.get('sort', 'group') == 'group' %}var(--accent){% else %}rgba(255,255,255,0.1){% endif %}; color: white; transition: 0.2s;">Po Grupie</a>
    <a href="{{ url_for('dashboard', sort='date') }}" style="padding: 8px 20px; border-radius: 20px; text-decoration: none; font-weight: bold; background: {% if request.args.get('sort') == 'date' %}var(--accent){% else %}rgba(255,255,255,0.1){% endif %}; color: white; transition: 0.2s;">Po Dacie</a>
</div>

<div style="overflow-x: auto; overflow-y: auto; max-height: 33vh; padding-bottom: 20px; margin-bottom: 30px; border-bottom: 1px solid rgba(255,255,255,0.1);">
    <table class="leaderboard-table" style="margin-top: 0; min-width: 600px;">
        <thead style="position: sticky; top: 0; z-index: 10; background: var(--panel-bg);">
            <tr style="background: transparent; box-shadow: none;">
                <th class="col-rank">MSC</th>
                <th class="col-name" style="text-align: left;">GRACZ</th>
                <th class="col-points" style="text-align: center;">PKT</th>
                {% for m in last_matches %}
                    <th class="col-match">
                        <div style="white-space: nowrap;">{{ m.team1 }} - {{ m.team2 }}</div>
                        <span style="font-weight: normal;">{{ m.result_1 if m.played else '-' }}:{{ m.result_2 if m.played else '-' }}</span>
                    </th>
                {% endfor %}
            </tr>
        </thead>
        <tbody>
        {% for user in leaderboard %}
            <tr class="rank-{{ loop.index }}">
                <td style="text-align: center;">
                    {% if loop.index == 1 %}🥇
                    {% elif loop.index == 2 %}🥈
                    {% elif loop.index == 3 %}🥉
                    {% else %}{{ loop.index }}
                    {% endif %}
                </td>
                <td class="col-name-val">{{ user.name }}</td>
                <td class="col-points-val">{{ user.points }}</td>
                
                {% for pred in user.recent %}
                    <td class="col-match-val">
                        {% if pred and pred.pred_1 is not none %}
                            <div class="pred-score">{{ pred.pred_1 }}:{{ pred.pred_2 }}</div>
                            <span class="pred-points" style="
                                background: {% if pred.points == 10 %}var(--success){% elif pred.points == 2 %}var(--warning){% elif last_matches[loop.index0].played %}var(--danger){% else %}rgba(255,255,255,0.1){% endif %};
                                color: {% if pred.points > 0 or last_matches[loop.index0].played %}#000{% else %}white{% endif %};
                            ">
                                {% if last_matches[loop.index0].played %}+{{ pred.points }}{% else %}-{% endif %}
                            </span>
                        {% else %}
                            <span class="pred-none">Brak</span>
                        {% endif %}
                    </td>
                {% endfor %}
            </tr>
        {% endfor %}
        </tbody>
    </table>
</div>

{% for group_name, match_list in grouped.items() %}
    <h2 class="group-title">{{ group_name }}</h2>
    <div class="match-grid">
        {% for m in match_list %}
            {% set pred = pred_dict.get(m.id) %}
            {% set status_class = "" %}
            
            {% set match_started = m.start_time and now >= m.start_time %}
            
            {% if m.played and pred %}
                {% if pred.points == 10 %}
                    {% set status_class = "status-exact" %}
                {% elif pred.points == 2 %}
                    {% set status_class = "status-result" %}
                {% else %}
                    {% set status_class = "status-wrong" %}
                {% endif %}
            {% elif m.played and not pred %}
                {% set status_class = "status-wrong" %}
            {% endif %}
            
            <div class="match-card {{ status_class }}" id="match-{{ m.id }}">
                <div class="match-date">{{ m.date_time_str }}</div>
                
                <div class="teams">
                    <div class="team">
                        <img src="https://flagcdn.com/w40/{{ m.team1 | flag }}.png" alt="{{ m.team1 }}" onerror="this.onerror=null; this.src='https://placehold.co/40x26?text={{ m.team1 }}'">
                        <span class="team-name">{{ m.team1 | upper }}</span>
                    </div>
                    <div class="vs">
                        {% if m.played %}
                            <div style="font-size: 1.2rem; color: white;">{{ m.result_1 }} : {{ m.result_2 }}</div>
                        {% else %}
                            VS
                        {% endif %}
                    </div>
                    <div class="team">
                        <img src="https://flagcdn.com/w40/{{ m.team2 | flag }}.png" alt="{{ m.team2 }}" onerror="this.onerror=null; this.src='https://placehold.co/40x26?text={{ m.team2 }}'">
                        <span class="team-name">{{ m.team2 | upper }}</span>
                    </div>
                </div>
                
                {% if not match_started %}
                <form class="prediction-form" onsubmit="savePrediction(event, {{ m.id }})">
                    <div class="prediction-inputs">
                        <input type="number" id="pred1-{{ m.id }}" min="0" max="20" value="{{ pred.pred_1 if pred and pred.pred_1 is not none else '' }}">
                        <span style="font-weight: bold;">:</span>
                        <input type="number" id="pred2-{{ m.id }}" min="0" max="20" value="{{ pred.pred_2 if pred and pred.pred_2 is not none else '' }}">
                    </div>
                    <button type="submit" class="save-btn" id="btn-{{ m.id }}">Zapisz typ</button>
                </form>
                
                {% else %}
                <div style="display: flex; justify-content: space-between; align-items: center; margin-top: 10px; border-bottom: 1px solid rgba(255,255,255,0.1); padding-bottom: 15px;">
                    <div style="text-align: left; flex: 1;">
                        <span style="color: var(--text-secondary); font-size: 0.9rem;">Twój typ: </span>
                        <strong style="font-size: 1.1rem;">
                            {% if pred and pred.pred_1 is not none %}{{ pred.pred_1 }} : {{ pred.pred_2 }}{% else %}Brak{% endif %}
                        </strong>
                        <div style="margin-top: 5px; font-weight: bold; color: {% if pred and pred.points == 10 %}var(--success){% elif pred and pred.points == 2 %}var(--warning){% elif m.played %}var(--danger){% else %}var(--text-secondary){% endif %}">
                            {% if m.played %}+{{ pred.points if pred else 0 }} pkt{% else %}Oczekuje na wynik oficjalny...{% endif %}
                        </div>
                    </div>
                    {% if m.highlights_url %}
                    <div style="margin-left: 15px;">
                        <a href="{{ m.highlights_url }}" target="_blank" style="display: inline-block; padding: 10px 15px; background: #e62117; color: white; text-decoration: none; border-radius: 8px; font-weight: bold; font-size: 0.9rem; transition: 0.2s; box-shadow: 0 4px 6px rgba(0,0,0,0.3);">
                            🎬 Obejrzyj Skrót
                        </a>
                    </div>
                    {% endif %}
                </div>
                {% endif %}
                
                <!-- Others' bets -->
                <div style="margin-top: 15px; border-top: 1px solid rgba(255,255,255,0.05); padding-top: 10px;">
                    <div style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 10px; text-align: center;">Typy pozostałych graczy:</div>
                    {% set others = others_dict.get(m.id, []) %}
                    {% if others %}
                        <div style="display: flex; flex-direction: column; gap: 5px;">
                        {% for op in others %}
                            <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.9rem; background: rgba(0,0,0,0.2); padding: 5px 10px; border-radius: 4px;">
                                <span>{{ op.name }} <span style="font-size: 0.7rem; color: #777; margin-left: 5px;">{{ op.time }}</span></span>
                                <span style="font-weight: bold; color: {% if m.played and op.pts == 10 %}var(--success){% elif m.played and op.pts == 2 %}var(--warning){% elif m.played %}var(--danger){% else %}white{% endif %};">
                                    {% if op.p1 is not none %}{{ op.p1 }} : {{ op.p2 }}{% else %}Brak{% endif %}
                                </span>
                            </div>
                        {% endfor %}
                        </div>
                    {% else %}
                        <div style="text-align: center; font-size: 0.85rem; color: #555;">Nikt inny nie obstawił.</div>
                    {% endif %}
                </div>
            </div>
        {% endfor %}
    </div>
{% endfor %}

<script>
async function savePrediction(e, matchId) {
    e.preventDefault();
    const btn = document.getElementById('btn-' + matchId);
    const p1 = document.getElementById('pred1-' + matchId).value;
    const p2 = document.getElementById('pred2-' + matchId).value;
    
    btn.textContent = 'Zapisywanie...';
    btn.style.backgroundColor = 'var(--accent-hover)';
    
    try {
        const res = await fetch('/save_prediction', {
            method: 'POST',
            headers: {'Content-Type': 'application/json'},
            body: JSON.stringify({ match_id: matchId, pred_1: p1, pred_2: p2 })
        });
        const data = await res.json();
        if (data.success) {
            btn.textContent = 'Zapisano! ✅';
            btn.style.backgroundColor = 'var(--success)';
            setTimeout(() => {
                btn.textContent = 'Zapisz typ';
                btn.style.backgroundColor = 'rgba(255, 255, 255, 0.1)';
            }, 2000);
        } else {
            alert(data.error || 'Błąd zapisu');
            btn.textContent = 'Zapisz typ';
        }
    } catch(err) {
        alert('Błąd połączenia');
        btn.textContent = 'Zapisz typ';
    }
}
</script>
{% endblock %}
